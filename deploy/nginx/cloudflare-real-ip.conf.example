# Copy to /etc/nginx/snippets/cloudflare-real-ip.conf.
# Use Cloudflare's current IP ranges when generating this file.
#
# Example generation commands:
#   curl -s https://www.cloudflare.com/ips-v4 | sed 's#^#set_real_ip_from #' | sed 's#$#;#'
#   curl -s https://www.cloudflare.com/ips-v6 | sed 's#^#set_real_ip_from #' | sed 's#$#;#'
#
# Paste the generated set_real_ip_from lines below, then keep:

real_ip_header CF-Connecting-IP;
real_ip_recursive on;

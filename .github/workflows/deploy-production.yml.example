name: Deploy Production

# Production server:
#   Hetzner project: Navkwa Production
#   Hostname: navkwa-prod-01
#   Public IP: 49.12.103.75
#
# Required GitHub repository secrets:
#   PRODUCTION_HOST=49.12.103.75
#   PRODUCTION_USER=deploy
#   PRODUCTION_SSH_KEY=<private key for deploy user>

on:
  workflow_dispatch:

jobs:
  test:
    runs-on: ubuntu-24.04

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup PHP
        uses: shivammathur/setup-php@v2
        with:
          php-version: "8.3"
          extensions: pdo_pgsql, redis, mbstring, xml, curl, zip, bcmath, intl
          coverage: none

      - name: Install dependencies
        run: composer install --prefer-dist --no-interaction --no-progress

      - name: Prepare test environment
        run: |
          cp .env.example .env
          php artisan key:generate

      - name: Run tests
        run: php artisan test

  deploy:
    runs-on: ubuntu-24.04
    needs: test

    steps:
      - name: Start SSH agent
        uses: webfactory/ssh-agent@v0.9.0
        with:
          ssh-private-key: ${{ secrets.PRODUCTION_SSH_KEY }}

      - name: Add production host key
        run: |
          mkdir -p ~/.ssh
          ssh-keyscan -H "${{ secrets.PRODUCTION_HOST }}" >> ~/.ssh/known_hosts

      - name: Deploy release
        run: |
          ssh "${{ secrets.PRODUCTION_USER }}@${{ secrets.PRODUCTION_HOST }}" \
            'APP_SLUG=navkwa-website REPO_URL=git@github.com:eljakes/navkwa-website.git BRANCH=main /var/www/navkwa-website/shared/release-deploy.sh'
